{
  "name": "antigravity-pele",
  "version": "0.1.0",
  "description": "Cross-platform Mermaid 12.1 & extended diagram renderer for Google Antigravity powered by Obsidian Pele.",
  "author": "springtian <springtian@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/springtian1982/antigravity-pele#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/springtian1982/antigravity-pele.git"
  },
  "bugs": {
    "url": "https://github.com/springtian1982/antigravity-pele/issues"
  },
  "keywords": [
    "antigravity",
    "agy",
    "mermaid",
    "pele",
    "obsidian",
    "flexoki",
    "diagram",
    "svg",
    "mcp",
    "sidecar",
    "cli"
  ],
  "type": "module",
  "bin": {
    "agy-pele": "./dist/cli.cjs"
  },
  "files": [
    "plugin.json",
    "mcp_config.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "assets/",
    "bin/",
    "dist/",
    "rules/",
    "sidecars/",
    "skills/"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node scripts/build-tests.mjs && node --test .test-dist/*.test.cjs",
    "install:global": "node scripts/install.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pele": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
